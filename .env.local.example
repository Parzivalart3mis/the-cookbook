NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- AI (Gemini) — powers the AI Kitchen, meal planner, substitutions, voice ---
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash → 3.6-flash → flash-latest; lite: gemini-3.5-flash-lite → flash-lite-latest)
GEMINI_MODEL=
GEMINI_MODEL_LITE=

# --- YouTube Data API v3 — real, most-watched videos for recipe ideas (optional) ---
YOUTUBE_API_KEY=
# Optional: region for trending videos (default US)
YOUTUBE_REGION=

# --- tote pantry (AI Kitchen "From my pantry" / "High-protein") ---
# Your tote deployment, e.g. https://tote.vercel.app
TOTE_API_URL=
# Must equal PANTRY_SHARE_SECRET in tote
TOTE_API_KEY=
